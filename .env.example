# Local development only. Supply a password via your own ignored .env.
ADRIVA_DATABASE_URL=postgresql://adriva:CHANGE_ME@127.0.0.1:55432/adriva
ADRIVA_ENVIRONMENT=development
ADRIVA_ARTIFACT_ROOT=.local/artifacts
ADRIVA_POSTGRES_PASSWORD=CHANGE_ME
ADRIVA_RUNTIME_PASSWORD=CHANGE_ME_DIFFERENT_PASSWORD
# Compose examples require URL-safe passwords, or percent-encoded credentials in native URLs.
# No provider credentials are needed for offline fixtures.
